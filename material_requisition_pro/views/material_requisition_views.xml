<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Material Requisition Form View -->
        <record id="view_material_requisition_form" model="ir.ui.view">
            <field name="name">material.requisition.form</field>
            <field name="model">material.requisition</field>
            <field name="arch" type="xml">
                <form string="Material Requisition">
                    <header>
                        <button name="action_submit" type="object" string="Submit" 
                                class="btn-primary" states="draft"/>
                        <button name="action_approve" type="object" string="Approve" 
                                class="btn-primary" states="submitted"/>
                        <button name="action_reject" type="object" string="Reject" 
                                class="btn-secondary" states="submitted"/>
                        <button name="action_reset_to_draft" type="object" string="Reset to Draft" 
                                class="btn-secondary" states="rejected"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="department"/>
                            </group>
                            <group>
                                <field name="requested_by"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Requisition Lines">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="notes"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes" placeholder="Additional notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Material Requisition Tree View -->
        <record id="view_material_requisition_tree" model="ir.ui.view">
            <field name="name">material.requisition.tree</field>
            <field name="model">material.requisition</field>
            <field name="arch" type="xml">
                <tree string="Material Requisitions">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="department"/>
                    <field name="requested_by"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Material Requisition Search View -->
        <record id="view_material_requisition_search" model="ir.ui.view">
            <field name="name">material.requisition.search</field>
            <field name="model">material.requisition</field>
            <field name="arch" type="xml">
                <search string="Material Requisitions">
                    <field name="name"/>
                    <field name="department"/>
                    <field name="requested_by"/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                    <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Department" name="group_department" context="{'group_by':'department'}"/>
                        <filter string="Requested By" name="group_requested_by" context="{'group_by':'requested_by'}"/>
                        <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Material Requisition Action -->
        <record id="action_material_requisition" model="ir.actions.act_window">
            <field name="name">Material Requisitions</field>
            <field name="res_model">material.requisition</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_material_requisition_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first material requisition
                </p>
                <p>
                    Material requisitions allow you to request materials from inventory.
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_material_requisition_root" name="Material Requisitions" sequence="10"/>
        <menuitem id="menu_material_requisition" name="Requisitions" parent="menu_material_requisition_root" 
                  action="action_material_requisition" sequence="10"/>

    </data>
</odoo>